# ─────────────────────────────────────────────────────────────────────────────
# webmee-email — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
#
# Required variables depend on which provider you use:
#   SendGrid only  → SENDGRID_API_KEY + EMAIL_FROM_ADDRESS (+ optional EMAIL_FROM_NAME)
#   SMTP only      → SMTP_HOST + SMTP_USER + SMTP_PASS + EMAIL_FROM_ADDRESS
#   Both (recommended for fallback) → all of the above
# ─────────────────────────────────────────────────────────────────────────────


# ─── SendGrid ─────────────────────────────────────────────────────────────────

# Your SendGrid Web API key.
# Create one at: https://app.sendgrid.com/settings/api_keys
# Required permissions: Mail Send → Full Access
#
SENDGRID_API_KEY=SG.replace_with_your_api_key

# Optional: Override the SendGrid API host.
# Only needed for EU data residency. Leave commented out for standard (US) region.
# SENDGRID_API_HOST=https://api.eu.sendgrid.com


# ─── Sender Identity ──────────────────────────────────────────────────────────

# The email address emails are sent FROM.
# IMPORTANT: This address (or its domain) must be verified in SendGrid.
#   Single sender:  https://app.sendgrid.com/settings/sender_auth/senders
#   Domain auth:    https://app.sendgrid.com/settings/sender_auth
#
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Display name shown in the recipient's email client (optional).
# Example: "TicketMee" → appears as: TicketMee <noreply@yourdomain.com>
#
EMAIL_FROM_NAME=YourApp


# ─── SMTP (fallback or alternative to SendGrid) ────────────────────────────────

# SMTP server hostname.
# Examples:
#   Gmail:      smtp.gmail.com
#   Mailtrap:   sandbox.smtp.mailtrap.io  (for local dev/testing)
#   Mailgun:    smtp.mailgun.org
#   Amazon SES: email-smtp.us-east-1.amazonaws.com
#
SMTP_HOST=smtp.mailtrap.io

# SMTP port (optional — default: 587).
# 587 = STARTTLS (recommended), 465 = TLS, 25 = unencrypted (avoid)
#
SMTP_PORT=587

# SMTP authentication credentials.
#
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Use TLS? (optional — default: false)
# false = STARTTLS on port 587 (recommended)
# true  = Direct TLS on port 465
#
SMTP_SECURE=false
