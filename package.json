{
  "name": "webmee-email",
  "version": "1.0.0",
  "description": "Plug-and-play email sending for Webmee services — template engine, multi-provider support, NestJS integration",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.mts",
        "default": "./dist/nestjs/index.mjs"
      },
      "require": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@nestjs/core"]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/config": ">=3.0.0",
    "@nestjs/core": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "email",
    "sendgrid",
    "smtp",
    "handlebars",
    "nestjs",
    "webmee",
    "template",
    "transactional"
  ],
  "license": "MIT"
}
